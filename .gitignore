# Runtime state / caches (may contain admin users, API keys, decryption keys)
state.json
logo-cache.json
logs/
runtime/

# Provider script credentials — live session tokens, never commit
scripts/*_user.json

# Build products — binaries are published on GitHub Releases, never committed
.build/
build/
# One tree per toolchain: the native build, the Windows cross-build, the
# sanitizer build. CI uses these names too.
build-*/
*.exe
*.dSYM/
restreamair
restreamair-menubar
restreamair-linux
restreamair-linux-arm64

# macOS
.DS_Store
**/.DS_Store
restream_selftest
restreamair-server
restream_selftest
restreamair-server

# In-source cmake output. `cmake -S . -B build` is the documented way to build,
# but a `cmake .` in the repo root drops these here — and they were committed
# once already.
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake
cmake_install.cmake
Makefile
*.a
__pycache__/

# Private work log: server addresses, tunnels and proxies. Kept locally only.
PROGRESS.md

# Captured provider commands, CDM devices, tokens and proxy test results —
# real sessions and credentials, never commit.
cdm-commands-*.txt
*.wvd
*.tokens
proxy-tests.json
